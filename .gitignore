# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Output: heavy artefacts ignored; specific text results are tracked.
# Use content-level excludes (output/**) instead of a bare directory exclude
# (output/) so we can re-include selected paths below — git won't descend
# into a directory whose name itself is excluded.
output/**
!output/.gitkeep
# Track the annotation pipeline's text outputs (sentences/, scenes/,
# intermediates) so reviewers can inspect every stage alongside
# docs/speaker_identification_summary.md. Heavy/binary outputs from
# downstream stages (02_build_network, 03_analyze, 04_visualize) stay
# ignored, as do figure files.
!output/annotations/
# the shared root sidecar (files directly inside a re-included directory are
# NOT covered by the directory's negation — they need their own)
!output/annotations/dataset_description.json
!output/annotations/sentences/
!output/annotations/sentences/**
!output/annotations/scenes/
!output/annotations/scenes/**
!output/annotations/intermediate/
!output/annotations/intermediate/**
# Track the brain-export products (TSV + JSON sidecars) so the brain-states
# pipeline and reviewers consume a versioned, validated copy. Stage-2 inputs
# (02_build_network) remain ignored — regenerable, and verified against this
# product by scripts/verify_network_export.py.
!output/annotations/network_metrics/
!output/annotations/network_metrics/**
# Track the topic-shift trace product (TSV + JSON sidecar) — same contract as
# network_metrics: versioned text regressors for the brain-states pipeline,
# independently verified by scripts/verify_topic_trace.py against the tracked
# sentence tables. The sentence-embedding cache it derives from
# (output/intermediate/) stays ignored — regenerable.
!output/annotations/topic_shift/
!output/annotations/topic_shift/**
# Track dialogue-embeddings timing TSVs + sidecars; the NPZ vector files stay
# untracked (~160 MB) — regenerable via scripts/export_dialogue_embeddings.py
# and bound to the tracked tables by scripts/verify_dialogue_embeddings.py.
!output/annotations/dialogue_embeddings/
!output/annotations/dialogue_embeddings/**
output/annotations/dialogue_embeddings/**/*.npz
# Track scene-segmentation evaluation results so reviewers can verify the
# numbers in docs/scene_segmentation_evaluation.md without rerunning.
!output/evaluation/
!output/evaluation/**
# Re-exclude binary/figure outputs even inside re-included paths
output/**/figures/
output/**/*.png
output/**/*.gexf

# Local agent/specification artifacts
.specify/
AGENTS.md
CLAUDE.md
specs/
# ...but DO track superpowers design specs — they document shipped features
# alongside their plans. Re-include the directory before its contents (a bare
# `specs/` exclude otherwise blocks git from descending into nested negations).
!docs/superpowers/specs/
!docs/superpowers/specs/**

# Local annotation data checkout
data/friends_annotations/
